# KernelSU Action -- Redmi K40 Pro / K40 Pro+ / Mi 11i / Mi 11X Pro (haydn)
# SukiSU Ultra + SUSFS 配置

CONFIG_ENV=config.env

# ================= 内核源码 =================
# PixelExperience 的 haydn 内核源码（5.4.180）
KERNEL_SOURCE=https://github.com/PixelExperience-Devices/kernel_xiaomi_haydn
KERNEL_SOURCE_BRANCH=thirteen
KERNEL_CONFIG=vendor/haydn-qgki_defconfig
# 小米 5.4 lahaina 内核刷写镜像名
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# 可选：产物命名
KERNEL_NAME=haydn-sukisu-ultra
ADD_LOCALVERSION_TO_FILENAME=false

# 5.4 QGKI 树常用附加参数（clang + lld 交叉编译）
EXTRA_CMDS=LD=ld.lld
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# ================= Clang =================
# 5.4 树可用较新 clang
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 全 LLVM 构建（5.10+ 推荐；5.4 建议保持 false）
USE_LLVM=false

# ================= GCC（binutils）=================
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ================= KernelSU / SukiSU =================
KSU_VARIANT=sukisu-ultra
# main = v4 模块化树（支持 KPM），但不自带 SUSFS，
# 会额外尝试 KernelSU 侧的 10_enable_susfs_for_ksu.patch
KSU_REF=main
# 5.4 属于旧内核，kprobes 常不可靠，建议 manual
KSU_HOOK_MODE=manual

# 自定义管理器签名（官方管理器留空）
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ================= SUSFS =================
# 注意：KSU_REF=main 不自带 SUSFS，除内核侧补丁外还会尝试 KSU 侧补丁；
# 而 5.4 的内核侧补丁在小米魔改树上本来就打不上（见上一次构建日志）。
# 若仍失败，建议：临时 ENABLE_SUSFS=false 出基础版，
# 或 fork susfs4ksu 针对 haydn 树重做 50_add_susfs_in_kernel-5.4.patch
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ================= 其它补丁 =================
# 5.9 以下内核需要回移 path_umount，否则模块挂载卸载失效
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
# SukiSU KPM 支持（builtin 树可用）
ENABLE_KPM=false

# ================= Kconfig =================
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
# 如编译报缺项可在此追加，例如：
# EXTRA_DEFCONFIG=CONFIG_KSU_MANUAL_HOOK=y
EXTRA_DEFCONFIG=

# ================= AnyKernel3 / 打包 =================
# false = 使用通用 AnyKernel3（osm0sis/AnyKernel3）
# Action 会自动适配：do.devicecheck=0、BLOCK=auto、A/B 槽位自动检测
# haydn 是 A/B 设备，通用包 + 自动检测即可正常刷入
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

NEED_DTBO=false
# 如需重新打包 boot.img，填一个同设备同 ROM 的可开机 boot.img 直链
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================= Runner =================
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
